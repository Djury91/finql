# Másold .env néven, és írd át a jelszavakat. A .env nem kerül a gitbe.

# --- Docker Compose: db szolgáltatás ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finql
POSTGRES_PORT=5432

# --- Alkalmazás ---
FINQL_ENV=dev
FINQL_LOG_LEVEL=INFO

# --- Adatbázis-kapcsolatok szerepkörönként (docs/04-adatbazis.md) ---
# A `finql db bootstrap` ezekből az URL-ekből állítja be a szerepkörök jelszavát,
# így minden jelszó egy helyen van megadva.
# 127.0.0.1, nem localhost: Windows-on a localhost előbb IPv6-ot (::1) próbál, ami ~2 s késés.

# Az alkalmazás (finql_app): csak az app sémához fér hozzá.
FINQL_DATABASE_URL=postgresql+asyncpg://finql_app:change-me-app@127.0.0.1:5432/finql
# Az LLM által generált SQL futtatása (finql_llm_reader): csak olvasás, csak az analytics nézetek.
FINQL_LLM_DATABASE_URL=postgresql+asyncpg://finql_llm_reader:change-me-llm@127.0.0.1:5432/finql
# Alembic és seed (finql_migrator → SET ROLE finql_owner).
FINQL_MIGRATION_DATABASE_URL=postgresql+psycopg://finql_migrator:change-me-migrator@127.0.0.1:5432/finql
# Csak a `finql db bootstrap`-hoz: a Compose superusere.
FINQL_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/finql
