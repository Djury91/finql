# Másold .env néven, és írd át a jelszavakat. A .env nem kerül a gitbe.

# --- Docker Compose: db szolgáltatás ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finql
POSTGRES_PORT=5432

# --- Alkalmazás ---
FINQL_ENV=dev
FINQL_LOG_LEVEL=INFO
# 0. fázis: a bootstrap superuserrel csatlakozunk.
# Az 1. fázistól külön szerepkörök lesznek (finql_app, finql_llm_reader), lásd docs/04-adatbazis.md.
# 127.0.0.1, nem localhost: Windows-on a localhost előbb IPv6-ot (::1) próbál, ami ~2 s késés.
FINQL_DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/finql
