# Másold .env néven, és írd át a jelszavakat. A .env nem kerül a gitbe.

# --- Docker Compose: db szolgáltatás ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finql
POSTGRES_PORT=5432

# --- Alkalmazás ---
FINQL_ENV=dev
FINQL_LOG_LEVEL=INFO

# --- Adatbázis-kapcsolatok szerepkörönként (docs/04-adatbazis.md) ---
# A `finql db bootstrap` ezekből az URL-ekből állítja be a szerepkörök jelszavát,
# így minden jelszó egy helyen van megadva.
# 127.0.0.1, nem localhost: Windows-on a localhost előbb IPv6-ot (::1) próbál, ami ~2 s késés.

# Az alkalmazás (finql_app): csak az app sémához fér hozzá.
FINQL_DATABASE_URL=postgresql+asyncpg://finql_app:change-me-app@127.0.0.1:5432/finql
# Az LLM által generált SQL futtatása (finql_llm_reader): csak olvasás, csak az analytics nézetek.
FINQL_LLM_DATABASE_URL=postgresql+asyncpg://finql_llm_reader:change-me-llm@127.0.0.1:5432/finql
# Alembic és seed (finql_migrator → SET ROLE finql_owner).
FINQL_MIGRATION_DATABASE_URL=postgresql+psycopg://finql_migrator:change-me-migrator@127.0.0.1:5432/finql
# Csak a `finql db bootstrap`-hoz: a Compose superusere.
FINQL_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/finql

# --- Bejelentkezés (JWT) ---
# Legalább 32 karakter: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINQL_JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
FINQL_ACCESS_TOKEN_TTL_MINUTES=30
# A `finql user demo` ezzel a jelszóval hozza létre a demófelhasználókat.
FINQL_DEMO_PASSWORD=change-me-demo

# --- LLM (text-to-SQL, docs/05-text-to-sql-biztonsag.md) ---
# anthropic: Claude (API-kulcs kell). fake: API-kulcs nélkül, csak a projektterv példakérdéseire felel.
FINQL_LLM_PROVIDER=anthropic
# Üresen hagyva az SDK saját keresése jön: ANTHROPIC_API_KEY vagy `ant auth login` profil.
FINQL_ANTHROPIC_API_KEY=
FINQL_LLM_MODEL=claude-sonnet-5-5
FINQL_LLM_EFFORT=medium
# A generált SQL futtatásának korlátai (az alapértékek a large skálán vannak kalibrálva).
# FINQL_SQL_STATEMENT_TIMEOUT_MS=5000
# FINQL_SQL_DEFAULT_LIMIT=200
# FINQL_SQL_MAX_LIMIT=1000
# FINQL_SQL_MAX_PLAN_ROWS=50000000
# FINQL_SQL_MAX_COST=100000000

# --- Dinamikus few-shot (4. fázis) ---
# A kérdéshez leghasonlóbb példák (data/sql_examples.yaml) száma a promptban; 0 = kikapcsolva.
# Betöltés az adatbázisba: `finql examples sync`. Embedding nélkül a few-shot kimarad.
# FINQL_FEW_SHOT_K=3
# voyage: Voyage AI (API-kulcs kell, https://dashboard.voyageai.com).
# hashing: kulcs nélküli, csak lexikális hasonlóság (tesztek, demó).
FINQL_EMBEDDING_PROVIDER=voyage
FINQL_VOYAGE_API_KEY=
# FINQL_EMBEDDING_MODEL=voyage-4

# --- Dokumentumok (RAG) ---
# Ugyanazt az embeddinget használja. Betöltés: `finql ingest` (data/documents). Embedding nélkül a
# keresés csak teljes szöveges, a betöltéshez viszont kell (vagy FINQL_EMBEDDING_PROVIDER=hashing).
# A válasz promptjába kerülő források száma:
# FINQL_RAG_TOP_K=5
